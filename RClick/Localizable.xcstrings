    "A next-generation Finder context menu enhancer for macOS, providing zero-configuration productivity actions and fast application launchers." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A next-generation Finder context menu enhancer for macOS, providing zero-configuration productivity actions and fast application launchers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejorador de menú contextual de Finder de última generación para macOS, con acciones de productividad sin configuración y lanzadores rápidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Améliorateur de menu contextuel Finder de nouvelle génération pour macOS, offrant des actions de productivité prêtes à l'emploi et des lanceurs d'applications rapides."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 向け次世代 Finder コンテキストメニュー拡張機能。設定不要の生産性アクションと高速アプリランチャーを提供します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专为 macOS 打造的新一代访达右键菜单增强工具，提供开箱即用的高频生产力动作与快速应用启动器。"
          }
        }
      }
    },
